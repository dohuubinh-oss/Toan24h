# ==========================================
# CẤU HÌNH MÔI TRƯỜNG TOÁN 24H (PRODUCTION)
# ==========================================

# 1. Cấu hình Backend & Database
DB_DSN="host=postgres user=admin password=secretpassword dbname=toan24h port=5432 sslmode=disable TimeZone=Asia/Ho_Chi_Minh"
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
REDIS_URL="redis:6379"
REDIS_PASSWORD="secretredis"
PORT="8080"
GIN_MODE="release"

# 2. Cấu hình Bảo mật
JWT_SECRET="THAY_BANG_CHUOI_RANDOM_32_KY_TU_TRO_LEN"
FRONTEND_URL="http://toan24h.vn"

# 3. Tích hợp AI (Gemini)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 4. Tích hợp Bot Telegram
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_USERNAME="YOUR_BOT_USERNAME"

# 5. Tích hợp Cổng thanh toán (PayOS Open Banking)
PAYOS_CLIENT_ID="YOUR_PAYOS_CLIENT_ID"
PAYOS_API_KEY="YOUR_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="YOUR_PAYOS_CHECKSUM_KEY"

# 6. Cấu hình Frontend (Client-side variables)
NEXT_PUBLIC_API_URL="/api/v1"
BACKEND_URL="http://backend:8080"

